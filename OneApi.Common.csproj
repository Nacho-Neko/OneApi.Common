<Project>
  <PropertyGroup>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
  </PropertyGroup>

  <Sdk Name="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>OneApi cross-service shared primitives: LLM invoke routing, usage kinds/units/billing types, dispatch wire DTOs/error codes, Edge ↔ Gateway MagicOnion dispatch RPC (ILlmDispatchService), the gwconsul channel used to call that RPC, catalog slug parsing, local Claude token counting. Single source of truth across OneApi.Gateway, Meeko.Demux and Tavern.Gateway.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Yomi.Gateway.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reverse-engineered Claude 3+/4.x vocabulary (ctoc, 38,360 API-verified tokens),
         gzipped JSON string array. Consumed by ClaudeTokenCounter. -->
    <EmbeddedResource Include="Tokenization\ClaudeVocab.json.gz" LogicalName="OneApi.Common.Tokenization.ClaudeVocab.json.gz" />
  </ItemGroup>

  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' == 'true'">
    <PackageReference Include="Consul" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="MagicOnion.Abstractions" />
    <PackageReference Include="MagicOnion.Client" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' != 'true'">
    <PackageReference Include="Consul" Version="1.8.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageReference Include="MagicOnion.Abstractions" Version="7.11.0" />
    <PackageReference Include="MagicOnion.Client" Version="7.11.0" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!--
      注册基类 ConsulRegistration、业务树编码与平台 Meta 键名都在这里；检出时 Platform.Common 与本库同级。
      只引用拆出来的 Platform.Common.Discovery，不引用整个 Platform.Common：后者带 ASP.NET Core 框架引用，
      会顺着本库传到 OneApi 的每个 provider，让它们在 dotnet/runtime 镜像里启动即退出。
    -->
    <ProjectReference Include="..\Platform.Common\Platform.Common.Discovery\Platform.Common.Discovery.csproj" />
  </ItemGroup>

</Project>
