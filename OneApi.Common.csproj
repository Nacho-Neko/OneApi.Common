<Project>
  <PropertyGroup>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
  </PropertyGroup>

  <Sdk Name="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>OneApi cross-service shared primitives: LLM invoke routing, usage kinds/units/billing types, dispatch wire DTOs/error codes, Edge ↔ Gateway MagicOnion dispatch RPC (ILlmDispatchService), catalog slug parsing. Single source of truth across OneApi.Gateway, Meeko.Demux and Tavern.Gateway.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' == 'true'">
    <PackageReference Include="MagicOnion.Abstractions" />
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' != 'true'">
    <PackageReference Include="MagicOnion.Abstractions" Version="7.10.0" />
    <PackageReference Include="MessagePack" Version="3.1.7" />
  </ItemGroup>

</Project>
